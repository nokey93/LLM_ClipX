<?xml version="1.0" encoding="utf-8"?>
<pbf version="2.1" format="ecad"
     xsi:noNameSpaceSchemaLocation="pbf.xsd"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <pl/>
  <o name="{ProjectName}" type="clipprj.project" id="0">
    <pl><p name="clipprj.gapBetweenItems">0.03</p></pl>
    <ol>
      <o name="Schiene 1" type="clipprj.rail" id="1">
        <pl>
          <p name="clipprj.articleNumber">0801733</p>
          <p name="clipprj.articleDesignation">NS 35/ 7,5 PERF 2000MM</p>
          <p name="clipprj.length">{railLength}</p>
        </pl>
        <ol>
          <!-- fixed 20 mm left margin -->
          <o type="clipprj.mountingSpacingLeft" id="2"><pl><p name="clipprj.width">20.00</p></pl></o>

          <!-- repeat for every product -->
          <o type="clipprj.generic" id="{id}">
            <pl>
              <p name="clipprj.articleNumber">{article}</p>
              <p name="clipprj.width">{width}</p>
              <p name="clipprj.height">{height}</p>
              <p name="clipprj.rotated">0</p>
              <p name="clipprj.description"/>
              <p name="clipprj.connectionId">{conn}</p>
            </pl>
          </o>

          <!-- optional gaps -->
          <o type="clipprj.blockingSurface" id="{id}"><pl><p name="clipprj.width">{gapWidth}</p></pl></o>

          <!-- fixed 20 mm right margin -->
          <o type="clipprj.mountingSpacingRight" id="{id}"><pl><p name="clipprj.width">20.00</p></pl></o>
        </ol>
      </o>

      <!-- optional loose accessories here -->

    </ol>
  </o>

  <!-- optional <refs> if you used accessories -->
</pbf>